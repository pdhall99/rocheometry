# datatype:
# - {name: q, datatype: string, description: mass ratio M2/M1 as printed}
# - {name: F=1.0, datatype: string, meta: {units: separation}}
# - {name: F=1.05, datatype: string, meta: {units: separation}}
# - {name: F=1.1, datatype: string, meta: {units: separation}}
# - {name: F=1.2, datatype: string, meta: {units: separation}}
# - {name: F=1.4, datatype: string, meta: {units: separation}}
# - {name: F=1.6, datatype: string, meta: {units: separation}}
# - {name: F=1.8, datatype: string, meta: {units: separation}}
# - {name: F=1.9, datatype: string, meta: {units: separation}}
# - {name: F=1.95, datatype: string, meta: {units: separation}}
# - {name: F=2.0, datatype: string, meta: {units: separation}}
# meta:
#   title: 'Table 7: Volume radius of the secondary, contact configurations'
#   reference: Mochnacki 1984, Table 7
#   sources:
#   - title: Mochnacki S. W., 1984, ApJS, 55, 551, Accurate Integrations of the Roche Model
#     bibcode: 1984ApJS...55..551M
#     url: https://ui.adsabs.harvard.edu/abs/1984ApJS...55..551M
#   retrieval:
#     method: 'three readings of the ADS scan: its OCR text layer and tesseract passes over
#       the page images at 400 and 600 dpi. A row of Table 14 that the readings split differently,
#       and nine other cells where they disagreed or one missed a value, were settled on the
#       600 dpi image; three of those corrected a digit two readings had agreed on (Table 6
#       q=0.12 F=1.8, Table 10 q=0.50 F=1.0, Table 11 q=0.50 F=1.9). Every value then passes
#       the tables'' identities: Table 2 is C1/F and Table 3 linear in F between C1 and C2 of
#       Table 1; the F = 1 columns equal the detached tables'' F = 1 columns; and Gauss''s law
#       summed over both components ties Tables 6, 7, 10, 11, 14 and 15 (worst 0.78 of the propagated
#       rounding)'
#     date: '2026-11-09'
#     typography: FORTRAN-style exponents such as 6.45428-1 and 1.68243+1 are stored as 6.45428e-1
#       and 1.68243e+1; no digit changed
#   conventions:
#     mass_parameter:
#       column: q
#       kind: own_mass_ratio
#       description: q = M2/M1 <= 1; the tabulated component is the secondary, qi = q
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: tabulated C = 2/(1+q)/r1 + 2q/(1+q)/r2 + (x - q/(1+q))^2 + y^2 = 2U, primary
#         at the origin
#     fill_out:
#       kind: fill_out_contact
#       description: F = (C1 - C)/(C1 - C2) + 1 between the inner and outer contact surfaces,
#         so Rocheometry's fill-out factor is F - 1
#   contact_split: Mochnacki divides a contact envelope by the plane through L1 normal to the
#     line of centres; Rocheometry divides it along the gravity watershed. Only the envelope totals
#     are comparable, so the primary table's columns compare the totals over both components
#     with Rocheometry's two parts; this table is read as a partner of the primary's
