# %ECSV 1.0
# ---
# datatype:
# - {name: m, datatype: string, description: mass ratio M2/M1 as printed}
# - {name: x1, datatype: string, description: 'L1, measured from M1 (eq. 9)', meta: {printed_symbol: x1, rocheometry_quantity: l1_position_x, component: primary}}
# - {name: x1-mu, datatype: string, description: 'L1, measured from the centre of mass', meta: {printed_symbol: x1 - mu, rocheometry_quantity: l1_position_x, component: primary, frame: {kind: centre_of_mass, component_on: -x, description: 'x - mu, measured from the centre of mass, primary on -x'}}}
# - {name: C1, datatype: string, description: C at L1 (eq. 10), meta: {printed_symbol: C1, rocheometry_quantity: l1_potential, component: primary}}
# - {name: Omega1, datatype: string, description: Omega at L1 (eq. 3), meta: {printed_symbol: Omega1, rocheometry_quantity: l1_potential, component: primary, potential: {kind: plavec_kratochvil_omega, description: 'Omega = (1+m) C / 2, their eq. 3 (4.00000 at m = 1). It differs from the Kopal/Wilson-Devinney Omega = 1/r1 + m(1/r2 - x) + (1+m)(x^2+y^2)/2 by the constant m^2/(2(1+m)): eq. 2 omits it but eq. 4 keeps it, and the tabulated values follow eqs. 3-4'}}}
# - {name: x1', datatype: string, description: 'back of the primary''s lobe on the x-axis, P1'' (eq. 11)', meta: {printed_symbol: x1', rocheometry_quantity: named_point_x, component: primary, radius: back}}
# - {name: x1'', datatype: string, description: 'back of the secondary''s lobe on the x-axis, P1'''' (eq. 12)', meta: {printed_symbol: x1'', rocheometry_quantity: named_point_x, component: secondary, radius: back, frame: {kind: companion_origin, description: 'the paper''s x for a secondary-local quantity: x = 1 - x_local'}}}
# - {name: phi, datatype: string, description: 'angle in degrees between the x-axis and the critical curve at L1, tan^2 phi = -C_xx/C_yy (eq. 15)', meta: {printed_symbol: phi, rocheometry_quantity: l1_cone_angle_degrees, component: primary, units: degrees}}
# meta:
#   title: 'Table 1: the inner Lagrangian point L1 and the innermost contact surface C = C1'
#   reference: Plavec & Kratochvil 1964, Table 1
#   sources:
#   - title: Plavec M., Kratochvil P., 1964, BAICz, 15, 165, Tables for the Roche Model of Close
#       Binaries
#     bibcode: 1964BAICz..15..165P
#     url: https://ui.adsabs.harvard.edu/abs/1964BAICz..15..165P
#   retrieval:
#     method: 'two independent readings of the ADS scan (no text layer): values read from the
#       page images at 300 dpi, and tesseract OCR of fixed column crops; 1318 of 1334 values
#       agreed digit for digit, and all 16 disagreements were tesseract misreads, settled on
#       the page image at 600 dpi'
#     date: '2026-10-14'
#     typography: raised decimal points stored as '.'; the y and z radii are printed with a
#       leading +-, and are stored as the positive value; no digit changed
#   conventions:
#     mass_parameter:
#       column: m
#       kind: secondary_to_primary_ratio
#       description: m = M2/M1 <= 1; each column names the component it describes
#     frame:
#       kind: component_local
#       description: origin at the primary (the more massive star, M1), secondary at x = 1,
#         separation 1
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: C = 2(1-mu)/r1 + 2mu/r2 + (x-mu)^2 + y^2 = 2U, their eqs. 4-5; identical
#         to Mochnacki's C
#   allowance_half_units: 2.0
#   allowance_reason: the authors state the fifth decimal is uncertain by one unit (comparison
#     with Kopal 1954)
m x1 x1-mu C1 Omega1 x1' x1'' phi
