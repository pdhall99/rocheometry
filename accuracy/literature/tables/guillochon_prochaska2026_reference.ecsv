# %ECSV 1.0
# ---
# datatype:
# - {name: qE, datatype: string, description: 'q_E = M1/M2, as printed (seven figures)'}
# - {name: log10_qE, datatype: string, description: 'log10 q_E, exact: the grid is 10^(k/6)'}
# - {name: RL, datatype: string, description: 'R_L/a, the volume-equivalent radius of M1''s Roche lobe', meta: {rocheometry_quantity: lobe_volume_radius, units: separation, allowance_relative: 1.0e-10, allowance_reason: 'Rocheometry''s Reference contract is 1e-10 relative, looser than the source'}}
# - {name: RL_von_zeipel, datatype: string, description: 'R_L/a again, from the authors'' von Zeipel identity (a check of their own)'}
# - {name: xL1, datatype: string, description: 'x_L1/a, the distance of L1 from M1', meta: {rocheometry_quantity: l1_position_x, units: separation, allowance_relative: 1.0e-10, allowance_reason: 'Rocheometry''s Reference contract is 1e-10 relative, looser than the source'}}
# - {name: RL_over_rH, datatype: string, description: 'R_L/r_H, derived from R_L/a'}
# meta:
#   title: 'Reference solution: the volume-equivalent Roche-lobe radius and the L1 position
#     over 1e-6 <= q_E <= 1e6'
#   reference: Guillochon & Prochaska 2026, reference table
#   sources:
#   - title: Guillochon J., Prochaska J. X., 2026, Exact Asymptotics of the Roche-Lobe Radius
#       (manuscript), roche_lobe_reference_table.dat, the 73-point reference solution
#     url: https://github.com/guillochon/roche-lobe/blob/1c8e174/paper/roche_lobe_reference_table.dat
#   retrieval:
#     method: copied from the authors' machine-readable file at commit 1c8e174 (2026-10-22)
#     date: '2026-11-09'
#     typography: stored as the file prints them. The printed q_E are rounded to seven figures;
#       the grid is 10^(k/6) for k = -36..36 (six points a decade over 1e-6..1e6), which log10_qE
#       gives exactly and every printed q_E rounds to
#   conventions:
#     mass_parameter:
#       column: log10_qE
#       kind: own_mass_ratio
#       log10: true
#       description: q_E = M1/M2, the lobe's own mass over its companion's
#     frame:
#       kind: component_local
#       description: origin at M1, M2 at x = 1, separation 1
#     potential:
#       kind: kopal_omega
#       description: Kopal's Omega about M1 (not tabulated)
#   allowance_half_units: 1.0
#   allowance_reason: the authors estimate their error below 1e-13 absolute (an estimate, not
#     a bound)
qE log10_qE RL RL_von_zeipel xL1 RL_over_rH
