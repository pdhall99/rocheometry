# %ECSV 1.0
# ---
# datatype:
# - {name: q, datatype: string, description: 'M2/M1 for the lobe of M1, as input'}
# - {name: F, datatype: string, description: 'Mochnacki fill-out factor C1/C, as input'}
# - {name: OmegaF, datatype: string, description: Kopal's Omega of the fill-out surface, meta: {rocheometry_quantity: level_potential, level: {kind: fill_out_detached, fill_out_column: F}}}
# - {name: Rfr, datatype: string, description: radius of M1's fill-out surface along the point direction, meta: {rocheometry_quantity: level_radius, radius: point, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 21.0, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10'}}
# - {name: Rbk, datatype: string, description: radius of M1's fill-out surface along the back direction, meta: {rocheometry_quantity: level_radius, radius: back, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 21.0, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10'}}
# - {name: Ry, datatype: string, description: radius of M1's fill-out surface along the side direction, meta: {rocheometry_quantity: level_radius, radius: side, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 21.0, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10'}}
# - {name: Rz, datatype: string, description: radius of M1's fill-out surface along the pole direction, meta: {rocheometry_quantity: level_radius, radius: pole, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 21.0, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10'}}
# - {name: vol, datatype: string, description: volume inside the fill-out surface, meta: {rocheometry_quantity: volume, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 116, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10; the surfaces are smooth (no L1 cusp below F = 1), so the volume error is at most 1.05e-9 times the integral of r^2, 5.484 for the largest surface: 116 half-units'}}
# - {name: Req, datatype: string, description: volume-equivalent radius, meta: {rocheometry_quantity: volume_radius, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 24.0, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10; the volume error over 4 pi Req^2 is 1.05e-9 (r_rms/Req)^2, under 1.1e-9 here: 24 half-units'}}
# - {name: area, datatype: string, description: 'integral of r^2 over solid angle, which the program reports as the area (see the RocheTable''s Area column)', meta: {rocheometry_quantity: radial_area_integral, level: {kind: fill_out_detached, fill_out_column: F}, allowance_half_units: 349, allowance_reason: 'Brent''s method in r stops once the bracket is below 1e-9 (xcon), so radii carry up to 1e-9, plus 5e-11 printing: 21 half-units of the printed 1e-10; the error of the integral of r^2 is at most 2.1e-9 times the integral of r, at most sqrt(4 pi 5.484) by Cauchy-Schwarz: 349 half-units'}}
