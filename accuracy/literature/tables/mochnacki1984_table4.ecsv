# meta:
#   title: 'Table 4: Volume radius of the primary, detached configurations'
#   reference: Mochnacki 1984, Table 4
#   sources:
#   - title: Mochnacki S. W., 1984, ApJS, 55, 551, Accurate Integrations of the Roche Model
#     bibcode: 1984ApJS...55..551M
#     url: https://ui.adsabs.harvard.edu/abs/1984ApJS...55..551M
#   - title: 'Mochnacki S. W., 1985, ApJS, 59, 445, Erratum: Accurate Integrations of the Roche
#       Model'
#     bibcode: 1985ApJS...59..445M
#     url: https://ui.adsabs.harvard.edu/abs/1985ApJS...59..445M
#   retrieval:
#     method: 'two independent readings: values read from the ADS page images at 300 dpi, then
#       compared digit by digit with the scan''s OCR text layer; the three disagreements (Table
#       1 q=0.61 X2, q=0.89 C1; Table 17 q=0.60 F=0.95) were OCR misreads, settled on the page
#       image at 220-600 dpi'
#     date: '2026-10-14'
#     typography: FORTRAN-style exponents such as 1.14899-1 and 1.45514+2 are stored as 1.14899e-1
#       and 1.45514e+2; no digit changed
#   conventions:
#     mass_parameter:
#       column: q
#       kind: companion_mass_ratio
#       description: q = M2/M1 <= 1; the tabulated component is the primary, qi = 1/q
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: tabulated C = 2/(1+q)/r1 + 2q/(1+q)/r2 + (x - q/(1+q))^2 + y^2 = 2U, primary
#         at the origin
#     fill_out:
#       kind: fill_out_detached
#       description: F = C1/C inside the Roche lobe, so U = U_L1/F; F = 1 is the lobe
#   allowance_half_units: 1.5
#   allowance_reason: the author states volume radii are converged well beyond 1e-6; allow last-digit
#     rounding scatter
#   errata:
#     '0.04':
#       F=0.9:
#         source: 1985ApJS...59..445M
#         printed_1984: '5.59187e-1'
#         reason: programming mistake for primaries at fill-out 0.90 and 0.95, q = 0.04-0.20
#       F=0.95:
#         source: 1985ApJS...59..445M
