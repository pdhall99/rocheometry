# datatype:
# - {name: mu, datatype: string, description: secondary mass fraction as printed (1/3 and 2/7 are exact fractions)}
# - {name: x_L1, datatype: string, meta: {rocheometry_quantity: l1_position_x, frame: centre_of_mass}}
# - {name: omega_L1, datatype: string, meta: {rocheometry_quantity: l1_potential, convention: jacobi}}
# - {name: a_back, datatype: string, meta: {rocheometry_quantity: named_radius, radius: back, surface: lobe, printed_symbol: a1' = x1 - 1 + mu}}
# - {name: a_point, datatype: string, meta: {rocheometry_quantity: named_radius, radius: point, surface: lobe, printed_symbol: a1'' = 1 - mu - L1}}
# - {name: b_side, datatype: string, meta: {rocheometry_quantity: named_radius, radius: side, surface: lobe, printed_symbol: b1}}
# - {name: c_pole, datatype: string, meta: {rocheometry_quantity: named_radius, radius: pole, surface: lobe, printed_symbol: c1}}
# meta:
#   title: 'Table 1: dimensions of the innermost (L1) contact surface'
#   reference: Kuiper & Johnson 1956, Table 1
#   sources:
#   - title: Kuiper G. P., Johnson J. R., 1956, ApJ, 123, 90, Dimensions of Contact Surfaces
#       in Close Binaries
#     bibcode: 1956ApJ...123...90K
#     url: https://ui.adsabs.harvard.edu/abs/1956ApJ...123...90K
#   retrieval:
#     method: transcribed from the ADS page scan, read from the page image and checked against
#       the ADS text layer
#     date: '2026-10-13'
#     typography: the printed table omits leading '0.' on continuation rows and uses spaces
#       for decimal points; values here restore them without changing any digit
#   conventions:
#     mass_parameter:
#       column: mu
#       kind: own_mass_fraction
#       description: tabulated component (the secondary) has mass fraction mu; qi = mu/(1-mu)
#     frame:
#       kind: centre_of_mass
#       component_on: +x
#       description: origin at the centre of mass; tabulated component at x = 1 - mu; separation
#         1
#     potential:
#       kind: jacobi_centre_of_mass
#       description: tabulated Omega = (1-mu)/r1 + mu/r2 + (x^2+y^2)/2, identical to Rocheometry's
#         Jacobi U
#   allowance_half_units: 1.5
#   allowance_reason: '1955 desk calculation: last printed digits scatter by up to ~1.5 half-units
#     against independent 40-digit and Rocheometry values'
#   notes:
#     1/3:
#       a_point:
#         class: double_rounding
#         max_half_units: 2.5
#         evidence: 'a'''' = 1 - mu - x(L1) was rounded from the rounded x(L1): 0.4292485 rounds
#           up to 0.429249 (exact 0.42924843)'
#         reason: printed a'' = 1 - mu - x(L1) computed from the already rounded x(L1)
#     2/7:
#       a_point:
#         class: double_rounding
#         max_half_units: 2.5
#         evidence: 'double rounding as for 1/3: 0.4070525 rounds up to 0.407053 (exact 0.40705249)'
#         reason: printed a'' = 1 - mu - x(L1) computed from the already rounded x(L1)
#     '0.000001':
#       a_back:
#         class: source_error
#         max_half_units: 3.0
#         evidence: independent 40-digit mpmath solve gives 0.006570192005 (prints as 0.006570);
#           Rocheometry 0.0065701920
#         reason: last printed digit 1 low in the source
