# %ECSV 1.0
# ---
# datatype:
# - {name: m, datatype: string, description: mass ratio M2/M1 as printed}
# - {name: x2, datatype: string, description: 'L2, beyond M2 (eq. 23)', meta: {printed_symbol: x2, rocheometry_quantity: outer_position_x, component: secondary, frame: {kind: companion_origin, description: 'the paper''s x for a secondary-local quantity: x = 1 - x_local'}}}
# - {name: x2-mu, datatype: string, description: 'L2, measured from the centre of mass', meta: {printed_symbol: x2 - mu, rocheometry_quantity: outer_position_x, component: secondary, frame: {kind: centre_of_mass, component_on: +x, description: 'x - mu, measured from the centre of mass, secondary on +x'}}}
# - {name: C2, datatype: string, description: C at L2 (eq. 24), meta: {printed_symbol: C2, rocheometry_quantity: outer_potential, component: secondary}}
# - {name: y21, datatype: string, description: 'radius along +y from M1 to the surface C = C2, eq. 25', meta: {printed_symbol: +-y21, rocheometry_quantity: axis_crossing, component: primary, axis: +y, level: {point: L2}}}
# - {name: z21, datatype: string, description: 'radius along +z from M1 to the surface C = C2, eq. 26', meta: {printed_symbol: +-z21, rocheometry_quantity: axis_crossing, component: primary, axis: +z, level: {point: L2}}}
# - {name: y22, datatype: string, description: 'radius along +y from M2 to the surface C = C2, eq. 27', meta: {printed_symbol: +-y22, rocheometry_quantity: axis_crossing, component: secondary, axis: +y, level: {point: L2}}}
# - {name: z22, datatype: string, description: 'radius along +z from M2 to the surface C = C2, eq. 28', meta: {printed_symbol: +-z22, rocheometry_quantity: axis_crossing, component: secondary, axis: +z, level: {point: L2}}}
# - {name: x2', datatype: string, description: 'the surface C = C2 on the x-axis behind M1, P2''', meta: {printed_symbol: x2', rocheometry_quantity: axis_crossing, component: primary, axis: -x, level: {point: L2}}}
# meta:
#   title: 'Table 3: the outer Lagrangian point L2 and the outermost contact surface C = C2'
#   reference: Plavec & Kratochvil 1964, Table 3
#   sources:
#   - title: Plavec M., Kratochvil P., 1964, BAICz, 15, 165, Tables for the Roche Model of Close
#       Binaries
#     bibcode: 1964BAICz..15..165P
#     url: https://ui.adsabs.harvard.edu/abs/1964BAICz..15..165P
#   retrieval:
#     method: 'two independent readings of the ADS scan (no text layer): values read from the
#       page images at 300 dpi, and tesseract OCR of fixed column crops; 1318 of 1334 values
#       agreed digit for digit, and all 16 disagreements were tesseract misreads, settled on
#       the page image at 600 dpi'
#     date: '2026-10-14'
#     typography: raised decimal points stored as '.'; the y and z radii are printed with a
#       leading +-, and are stored as the positive value; no digit changed
#   conventions:
#     mass_parameter:
#       column: m
#       kind: secondary_to_primary_ratio
#       description: m = M2/M1 <= 1; each column names the component it describes
#     frame:
#       kind: component_local
#       description: origin at the primary (the more massive star, M1), secondary at x = 1,
#         separation 1
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: C = 2(1-mu)/r1 + 2mu/r2 + (x-mu)^2 + y^2 = 2U, their eqs. 4-5; identical
#         to Mochnacki's C
#   allowance_half_units: 2.0
#   allowance_reason: the authors state the fifth decimal is uncertain by one unit (comparison
#     with Kopal 1954)
#   notes:
#     '1.00':
#       x2':
#         class: ill_conditioned
#         max_half_units: 170.0
#         reason: at m = 1, C2 = C3, so the surface C = C2 touches the x-axis at L3 and x2'
#           = x3. Near a tangency the crossing moves as the square root of any error in the
#           level. The printed value is the crossing for a level 2.9e-6 above C2, inside the
#           authors' stated one-unit uncertainty in C
#         evidence: C2 = 3.4567962241 and x3 = -0.6984061446; C(-0.69757) - C2 = +2.90e-6, and
#           that level (3.4567991) still rounds to the printed C2 = 3.45680. At m = 0.98 the
#           printed x2' agrees (-1.49 half-units)
m x2 x2-mu C2 y21 z21 y22 z22 x2'
