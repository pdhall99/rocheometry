# - {name: C2, datatype: string, description: 'outer contact potential, at L2 behind the secondary', meta: {rocheometry_quantity: outer_potential, printed_symbol: C2}}
# - {name: X1, datatype: string, meta: {rocheometry_quantity: l1_position_x, printed_symbol: X1}}
# - {name: X2, datatype: string, description: 'L2, beyond the secondary', meta: {rocheometry_quantity: outer_position_x, printed_symbol: X2}}
# meta:
