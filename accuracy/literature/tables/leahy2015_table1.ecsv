# - {name: F, datatype: string, description: 'fill-out factor: 1 is the Roche lobe'}
# - {name: R, datatype: string, description: 'radius of the lobe in the direction (theta, phi)', meta: {rocheometry_quantity: level_radius, theta_column: theta, phi_column: phi, level: {kind: fill_out_detached, fill_out_column: F}, units: separation}}
