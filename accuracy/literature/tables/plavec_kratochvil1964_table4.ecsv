# %ECSV 1.0
# ---
# datatype:
# - {name: m, datatype: string, description: mass ratio M2/M1 as printed}
# - {name: x3, datatype: string, description: 'L3, beyond M1 (eq. 29)', meta: {printed_symbol: x3, rocheometry_quantity: outer_position_x, component: primary}}
# - {name: x3-mu, datatype: string, description: 'L3, measured from the centre of mass', meta: {printed_symbol: x3 - mu, rocheometry_quantity: outer_position_x, component: primary, frame: {kind: centre_of_mass, component_on: -x, description: 'x - mu, measured from the centre of mass, primary on -x'}}}
# - {name: C3, datatype: string, description: C at L3, meta: {printed_symbol: C3, rocheometry_quantity: outer_potential, component: primary}}
# - {name: y31, datatype: string, description: 'radius along +y from M1 to the surface C = C3, eq. 25', meta: {printed_symbol: +-y31, rocheometry_quantity: axis_crossing, component: primary, axis: +y, level: {point: L3}}}
# - {name: z31, datatype: string, description: 'radius along +z from M1 to the surface C = C3, eq. 26', meta: {printed_symbol: +-z31, rocheometry_quantity: axis_crossing, component: primary, axis: +z, level: {point: L3}}}
# - {name: y32, datatype: string, description: 'radius along +y from M2 to the surface C = C3, eq. 27', meta: {printed_symbol: +-y32, rocheometry_quantity: axis_crossing, component: secondary, axis: +y, level: {point: L3}}}
# - {name: z32, datatype: string, description: 'radius along +z from M2 to the surface C = C3, eq. 28', meta: {printed_symbol: +-z32, rocheometry_quantity: axis_crossing, component: secondary, axis: +z, level: {point: L3}}}
# meta:
#   title: 'Table 4: the Lagrangian point L3 and the surface C = C3'
#   reference: Plavec & Kratochvil 1964, Table 4
#   sources:
#   - title: Plavec M., Kratochvil P., 1964, BAICz, 15, 165, Tables for the Roche Model of Close
#       Binaries
#     bibcode: 1964BAICz..15..165P
#     url: https://ui.adsabs.harvard.edu/abs/1964BAICz..15..165P
#   retrieval:
#     method: 'two independent readings of the ADS scan (no text layer): values read from the
#       page images at 300 dpi, and tesseract OCR of fixed column crops; 1318 of 1334 values
#       agreed digit for digit, and all 16 disagreements were tesseract misreads, settled on
#       the page image at 600 dpi'
#     date: '2026-10-14'
#     typography: raised decimal points stored as '.'; the y and z radii are printed with a
#       leading +-, and are stored as the positive value; no digit changed
#   conventions:
#     mass_parameter:
#       column: m
#       kind: secondary_to_primary_ratio
#       description: m = M2/M1 <= 1; each column names the component it describes
#     frame:
#       kind: component_local
#       description: origin at the primary (the more massive star, M1), secondary at x = 1,
#         separation 1
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: C = 2(1-mu)/r1 + 2mu/r2 + (x-mu)^2 + y^2 = 2U, their eqs. 4-5; identical
#         to Mochnacki's C
#   allowance_half_units: 2.0
#   allowance_reason: the authors state the fifth decimal is uncertain by one unit (comparison
#     with Kopal 1954)
#   notes:
#     '0.36':
#       y31:
#         class: source_error
#         max_half_units: 2001.0
#         reason: 'misprint of one digit: 0.63642 for 0.62642'
#         evidence: the scan reads 0.63642, which breaks the column's steady fall (0.63424 at
#           m = 0.34, 0.61897 at m = 0.38); C3 = 3.2587309793 (printed 3.25873) and C(0, y,
#           0) = C3 at y = 0.6264205068; Rocheometry gives 0.6264205068
#     '0.62':
#       z31:
#         class: source_error
#         max_half_units: 1800.0
#         reason: 'misprint, transposed digits: 0.47895 for 0.48795'
#         evidence: the scan and tesseract both read 0.47895, which breaks the column's steady
#           fall (0.49132 at m = 0.60, 0.48465 at m = 0.64); C3 = 3.3645075831 (printed 3.36451)
#           and C(0, 0, z) = C3 at z = 0.4879467664; Rocheometry gives 0.4879467664
m x3 x3-mu C3 y31 z31 y32 z32
