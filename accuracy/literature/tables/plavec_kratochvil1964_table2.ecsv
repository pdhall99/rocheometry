# datatype:
# - {name: m, datatype: string, description: mass ratio M2/M1 as printed}
# - {name: mu, datatype: string, description: M2/(M1+M2), meta: {printed_symbol: mu, rocheometry_quantity: own_mass_fraction, component: secondary}}
# - {name: x11, datatype: string, description: 'x of the primary lobe''s orbital-plane vertex, C = C1 and C_x = 0 (eq. 16)', meta: {printed_symbol: x11, rocheometry_quantity: lobe_vertex, component: primary, coordinate: x}}
# - {name: y11, datatype: string, description: y of the primary lobe's orbital-plane vertex (eq. 16), meta: {printed_symbol: +-y11, rocheometry_quantity: lobe_vertex, component: primary, coordinate: y}}
# - {name: z11, datatype: string, description: 'z-radius of the primary lobe at x = x11, C(x11, 0, z) = C1 (eq. 21)', meta: {printed_symbol: +-z11, rocheometry_quantity: lobe_vertex, component: primary, coordinate: z}}
# - {name: x12, datatype: string, description: x of the secondary lobe's orbital-plane vertex (eq. 16), meta: {printed_symbol: x12, rocheometry_quantity: lobe_vertex, component: secondary, coordinate: x, frame: {kind: companion_origin, description: 'the paper''s x for a secondary-local quantity: x = 1 - x_local'}}}
# - {name: y12, datatype: string, description: y of the secondary lobe's orbital-plane vertex (eq. 16), meta: {printed_symbol: +-y12, rocheometry_quantity: lobe_vertex, component: secondary, coordinate: y}}
# - {name: z12, datatype: string, description: 'z-radius of the secondary lobe at x = x12, C(x12, 0, z) = C1 (eq. 22)', meta: {printed_symbol: +-z12, rocheometry_quantity: lobe_vertex, component: secondary, coordinate: z}}
# meta:
#   title: 'Table 2: vertices and z-radii of the critical Roche lobes C = C1'
#   reference: Plavec & Kratochvil 1964, Table 2
#   sources:
#   - title: Plavec M., Kratochvil P., 1964, BAICz, 15, 165, Tables for the Roche Model of Close
#       Binaries
#     bibcode: 1964BAICz..15..165P
#     url: https://ui.adsabs.harvard.edu/abs/1964BAICz..15..165P
#   retrieval:
#     method: 'two independent readings of the ADS scan (no text layer): values read from the
#       page images at 300 dpi, and tesseract OCR of fixed column crops; 1318 of 1334 values
#       agreed digit for digit, and all 16 disagreements were tesseract misreads, settled on
#       the page image at 600 dpi'
#     date: '2026-10-14'
#     typography: raised decimal points stored as '.'; the y and z radii are printed with a
#       leading +-, and are stored as the positive value; no digit changed
#   conventions:
#     mass_parameter:
#       column: m
#       kind: secondary_to_primary_ratio
#       description: m = M2/M1 <= 1; each column names the component it describes
#     frame:
#       kind: component_local
#       description: origin at the primary (the more massive star, M1), secondary at x = 1,
#         separation 1
#     potential:
#       kind: jacobi_centre_of_mass
#       scale: 2
#       description: C = 2(1-mu)/r1 + 2mu/r2 + (x-mu)^2 + y^2 = 2U, their eqs. 4-5; identical
#         to Mochnacki's C
#   allowance_half_units: 2.0
#   allowance_reason: the authors state the fifth decimal is uncertain by one unit (comparison
#     with Kopal 1954)
#   notes:
#     '0.22':
#       x11:
#         class: source_error
#         max_half_units: 5.0
#         reason: the printed vertex abscissa is 2.2 units of the last digit from the solution
#           of the paper's eq. 16
#         evidence: the scan reads -0.01173 unambiguously; solving C(x, y, 0) = C1 with C_x
#           = 0 gives x11 = -0.011752442552 and y11 = 0.520586517981 (the printed y11 = 0.52059
#           agrees); Rocheometry gives -0.0117524426
